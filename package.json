{
  "name": "retail-carrito-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ec2": "vite --mode ec2",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:browser": "vitest run --browser --config vitest.browser.config.js",
    "preview": "vite preview",
